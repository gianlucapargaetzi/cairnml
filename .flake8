[flake8]
max-line-length = 120
statistics = True
show-source = True
extend-ignore = B, E203, E501, W605
exclude = 
    cairnml/utilities/gpu/pynvml.py,
    cairnml/utilities/gpu/pyrsmi.py,
    cairnml/utilities/lowlevel/astor_unparse.py,
    cairnml/utilities/pigar,
    cairnml/utilities/plotlympl,
    cairnml/utilities/pyhocon,
    cairnml/utilities/requests_toolbelt,
    cairnml/backend_api/services